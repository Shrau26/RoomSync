/**
 * Offline geocode: returns { lat, lng, city, state, display } or null
 * Tries progressively fuzzy matches on the input string.
 */
export function offlineGeocode(input) {
  if (!input || input.trim().length < 3) return null;
  const raw = input.trim().toLowerCase().replace(/\s+/g, ' ');

  // 1. Exact match
  if (GEO_DB[raw]) return { ...GEO_DB[raw], display: input };

  // 2. Try all keys — check if input contains key OR key contains input
  for (const [key, val] of Object.entries(GEO_DB)) {
    if (raw.includes(key) || key.includes(raw)) {
      return { ...val, display: input };
    }
  }

  // 3. Word-by-word partial match (match any 2 consecutive words)
  const words = raw.split(/[\s,]+/).filter(w => w.length > 2);
  for (const [key, val] of Object.entries(GEO_DB)) {
    const keyWords = key.split(/[\s,]+/);
    const matches  = words.filter(w => keyWords.some(kw => kw.includes(w) || w.includes(kw)));
    if (matches.length >= Math.min(2, words.length)) {
      return { ...val, display: input };
    }
  }

  // 4. Single-word city match (last resort)
  for (const [key, val] of Object.entries(GEO_DB)) {
    const keyWords = key.split(/[\s,]+/);
    if (words.some(w => keyWords.includes(w) && w.length > 3)) {
      return { ...val, display: input };
    }
  }

  return null;
}

export default GEO_DB;
